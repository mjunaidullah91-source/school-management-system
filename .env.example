# Environment configuration for Ittihad Model School Management System
DEBUG=True
SECRET_KEY=django-insecure-ims-2026-prod-key-change-this-in-live-production
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# Database (PostgreSQL) configuration
# Set DB_NAME and DB_ENGINE to switch from SQLite to PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=edumanage_db
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432
CONN_MAX_AGE=600

# SSL / Security Configuration (Enable in HTTPS Production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
